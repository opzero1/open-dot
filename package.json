{
  "name": "open-dot",
  "version": "0.0.0",
  "private": true,
  "description": "A durable personal agent on OpenCode V2",
  "bin": {
    "open-dot": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./server.ts",
    "./tui": "./tui.ts"
  },
  "scripts": {
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p app/tsconfig.renderer.json",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "app:build": "bun app/build.ts",
    "app:start": "bun app/build.ts && electron app/build",
    "app:package": "bun app/build.ts && electron-builder --dir --config app/electron-builder.json",
    "app:test": "bun test app"
  },
  "dependencies": {
    "@opencode/client": "2.2.0",
    "@opencode/plugin": "2.2.0",
    "@opencode/theme": "2.2.0",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@pierre/diffs": "1.6.2",
    "@tanstack/react-virtual": "3.14.24",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.2"
}
